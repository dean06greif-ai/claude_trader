-
-def to_dir(rid, mode):
-    if rid is None:
-        return None
-    if mode == 3:
-        return rid
-    if mode == 5:
-        return 0 if rid <= 1 else (1 if rid == 2 else 2)
-    return rid // 3
-
-
-def expand(segments, hours_ts):
-    out = {}
-    for s in segments:
-        for t in hours_ts:
-            if s["from_ts"] <= t <= s["to_ts"]:
-                out[t] = s["regime"]
-    return out
-
-
-async def main():
-    aid = sys.argv[1]
-    cli = AsyncIOMotorClient(os.environ["MONGO_URL"])
-    db = cli[os.environ.get("DB_NAME", "trading_bot")]
