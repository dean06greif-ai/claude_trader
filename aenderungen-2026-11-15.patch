+    r1 = _sim({})                                   # Standard greift
+    assert r0["trades"] == r1["trades"] == 1
+    assert r0["slippage"] == 0.0
+    assert r1["slippage_percent"] == DEFAULT_SLIPPAGE_PCT
+    assert r1["slippage"] > 0
+    assert math.isclose(r0["pnl"] - r1["pnl"], r1["slippage"], abs_tol=0.02)
