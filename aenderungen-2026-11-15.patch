+def harmonize_volume(m: Optional[np.ndarray], symbol: str) -> Optional[np.ndarray]:
+    """EINE Volumen-Definition je Symbol (Analyse 15.11.2026, D3/Punkt 8).
+
+    Forex: Live-Scanner und die jüngsten ~30 Tage (Yahoo) kennen nur das
+    Ersatz-Volumen aus der Kerzenspanne; die ältere Backup-Historie brachte
+    dagegen Dukascopy-eigenes Volumen mit – in EINER Reihe zwei verschiedene
+    Größen, an der Nahtstelle sprangen rel_volume/VWAP. Für solche Symbole
+    wird die Backup-Historie auf dieselbe Ersatz-Definition umgerechnet, damit
+    Backtest und Live dieselbe Größe sehen. Symbole mit echtem Volumen bleiben
+    unverändert. (Bereits gespeicherte Alt-Kerzen ändern sich erst nach
+    erneutem Laden des Symbols.)"""
+    if m is None or not m.shape[0]:
+        return m
+    if source_info(symbol)["volume"] != "ersatz":
+        return m
+    out = m.copy()
+    close = np.where(out[:, 4] != 0, np.abs(out[:, 4]), np.nan)
+    vol = np.abs(out[:, 2] - out[:, 3]) / close * 1_000_000.0
+    out[:, 5] = np.maximum(np.nan_to_num(vol, nan=0.0), 1e-6)
+    return out
+
