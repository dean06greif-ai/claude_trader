-def _regime_time_share(live_segments):
-    total = 0.0
-    per = defaultdict(float)
-    for s in live_segments:
-        a, b = _seg_bounds(s)
-        if a is None or b is None or b <= a:
-            # fall back to unit weight
-            per[_seg_key(s)] += 1.0
-            total += 1.0
-            continue
-        dur = b - a
-        per[_seg_key(s)] += dur
-        total += dur
-    if total <= 0:
-        return {}, 0.0
-    return {k: v / total for k, v in per.items()}, total
