+                   + (f"die Volumen-Indikatoren ({', '.join(used)}) messen hier nur die Kerzenspanne."
+                      if used else "Volumen-Indikatoren messen hier nur die Kerzenspanne."))
+    scaled = sorted({i["symbol"] for i in infos if i["backup_scaled"]})
+    if scaled:
+        out.append(f"{', '.join(scaled)}: Historie vor dem Kontrakt-Listing stammt von einem verwandten "
+                   f"Instrument (skaliert) – nur prozentuale Bewegungen sind vergleichbar.")
