+    edge = {"r_n": 200, "r_sum": 80.0, "r_sq": 274.0}        # Ø +0,40 R
+    _expect(not es.significance(noise)["passed"], "Rauschen gilt als belegter Vorteil")
+    _expect(es.significance(edge, n_trials=50)["passed"], "klarer Vorteil wird nicht erkannt")
