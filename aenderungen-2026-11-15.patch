+def source_info(symbol: str) -> Dict:
+    """Woher kommen die Backtest-Kerzen dieses Symbols – und passen sie zum
+    gehandelten Kontrakt? Liefert Klartext für Ergebnis-Anzeige und Warnungen.
+
+      matches_traded  Kerzen stammen vom selben Markt, auf dem gehandelt wird
+      volume          "echt" | "ersatz" (aus der Kerzenspanne errechnet, siehe
+                      activity_volume) – Volumen-Indikatoren sind auf Ersatz-
+                      Volumen nur ein Spannen-Maß
+      backup          ältere Historie aus einer zweiten Quelle (Dukascopy);
+                      `backup_scaled` = anderes Instrument, auf das Preisniveau
+                      der Primärquelle skaliert (Index-CFD statt ETF-Perp)
+    """
+    sym = instruments.canonical(symbol)
+    source, _ref = _resolve(sym)
+    inst = instruments.get(sym)
+    is_fx = bool(inst is not None and inst.hist_source == "yahoo")
+    traded = "IBKR" if is_fx else "Bitunix Perp"
+    info = {
+        "symbol": sym, "source": source, "label": _SOURCE_LABELS.get(source, source),
+        "traded_on": traded,
+        "matches_traded": source in ("bitunix", "ibkr"),
+        "volume": "ersatz" if source in ("yahoo", "ibkr") else "echt",
+        "backup": "Dukascopy" if has_backup(sym) else None,
+        "backup_scaled": bool(has_backup(sym) and not is_fx),
+    }
+    notes = []
+    if not info["matches_traded"]:
+        notes.append(f"Backtest-Kerzen von {info['label']}, gehandelt wird {traded}: "
+                     f"Dochte und Volumen weichen ab")
+    if info["volume"] == "ersatz":
+        notes.append("kein echtes Volumen (Ersatzwert aus der Kerzenspanne)")
+    if info["backup_scaled"]:
+        notes.append("ältere Historie von einem verwandten Instrument (Dukascopy), "
+                     "auf das Preisniveau skaliert")
+    info["notes"] = notes
+    return info
