-        o = price - (step / 4 if up else -step / 4)
-        c = price + (step / 4 if up else -step / 4)
-        out.append({"timestamp": ts0 + i * 60_000, "open": o, "close": c,
-                    "high": max(o, c) + step / 2, "low": min(o, c) - step / 2,
-                    "volume": 5})
-    return out
