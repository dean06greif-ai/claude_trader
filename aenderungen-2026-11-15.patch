+    mism = sorted({i["symbol"] for i in infos if not i["matches_traded"] and i["volume"] == "echt"})
+    if mism:
+        out.append(f"{', '.join(mism)}: Kerzen von Binance Spot, gehandelt wird der Bitunix-Perp – "
+                   f"Stops an Dochten und Volumen-Regeln können live anders ausfallen.")
+    ers = sorted({i["symbol"] for i in infos if i["volume"] == "ersatz"})
+    used = sorted({str(i) for i in (indicators or []) if str(i) in VOLUME_INDICATORS})
